{
  "app_name": "VYOM",
  "version": "0.1.0",
  "environment": "development",
  "offline_mode": true,
  "debug": false,
  "inference": {
    "device_preference": "AUTO",
    "gpu_backend": "CUDA",
    "allow_cpu_fallback": true,
    "preferred_gpu_index": 0,
    "min_vram_mb": 2048,
    "fp16_enabled": false,
    "cpu_num_threads": 4
  },
  "models": {
    "models_dir": "models",
    "object_detector_path": "models/object_detector.onnx",
    "yolo_pt_path": "models/vyom_yolov8n_obb_smoke.pt",
    "hand_landmarker_path": "models/hand_landmarker.task",
    "smoke_metadata_path": "models/smoke_model_metadata.json",
    "verify_checksums": true
  },
  "datasets": {
    "data_dir": "data",
    "enigma360_path": "D:/space_eye/datasets/ENIGMA-360",
    "enigma360_subset": "exo",
    "enigma360_read_only": true,
    "raw_dir": "data/raw",
    "annotations_dir": "data/annotations",
    "yolo_obb_dir": "data/yolo_obb"
  },
  "logging": {
    "log_level": "INFO",
    "log_dir": "logs",
    "log_file": "vyom.log",
    "console_output": true,
    "json_format": false,
    "max_bytes": 10485760,
    "backup_count": 5
  },
  "storage": {
    "sessions_dir": "sessions",
    "database_path": "sessions/vyom_sessions.db"
  }
}

