# VYOM Environment Settings (.env.example)
# Copy this file to .env to customize local paths and compute preferences.
# Note: VYOM is offline-first. No cloud API keys or telemetry secrets are used.

# Application Environment
VYOM_ENV=development
VYOM_LOG_LEVEL=INFO

# Compute & Device Preferences: AUTO | CPU | GPU
VYOM_DEVICE_PREFERENCE=AUTO
VYOM_GPU_BACKEND=CUDA
VYOM_ALLOW_CPU_FALLBACK=true
VYOM_PREFERRED_GPU_INDEX=0

# External Datasets (Read-only)
VYOM_ENIGMA360_PATH=D:\space_eye\datasets\ENIGMA-360
VYOM_ENIGMA360_SUBSET=exo

# Local Storage Paths
VYOM_MODELS_DIR=models
VYOM_SESSIONS_DIR=sessions
VYOM_LOG_DIR=logs

